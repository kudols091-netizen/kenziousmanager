# Dependencies
node_modules/
package-lock.json

# Build and Packaging Output
dist/
build/
output/
scratch/
temp/
*.tmp

# User & Runtime Data
data/*.json
!data/presets.json
data/*.db
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.dat
data/*.corrupt-*
data/*.tmp
# Profile Chromium (chứa cookie đăng nhập thật), ảnh lỗi đăng bài
data/profiles/
data/gemini_browser_profile/
data/post_errors/
data/.migrated-from-resources
# Cookie phiên đăng nhập thật (sessionid...) — KHÔNG commit
data/cookies/
data/last-version.txt

# Bundled Chromium (398MB, đóng gói qua extraResources)
Chromium/

# Python cache
__pycache__/
*.pyc

# File backup
*.bak.js

# Script cá nhân mở trình duyệt theo tài khoản
Mo_IG_*.bat

# External Tool Executables (Fetch via setup script or place manually)
bin/*.exe
bin/*.zip
bin/ffmpeg
bin/ffprobe
bin/yt-dlp
# Python nhúng cho IG server (tạo bằng scripts/setup-ig-python.ps1)
bin/python/

# Environment & Credentials
.env
.env.local
*.pem
*.key
cookies*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini
